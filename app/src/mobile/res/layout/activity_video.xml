<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="port">

    <View
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black" />

    <FrameLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_below="@+id/statusBar"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            style="@style/Player.Vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="none" />

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/progress"
            layout="@layout/view_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 首次进入不自动起播时：用剧照垫底 + 一个大播放按钮，等用户主动点 -->
    </FrameLayout>

    <com.fongmi.android.tv.ui.custom.FadeImageView
        android:id="@+id/deferredCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 详情态：剧照整屏铺底，靠一层平滑渐变把下半部压暗，杜绝「半张图 + 硬分界线」 -->
    <View
        android:id="@+id/detailScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_detail"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 顶部压暗：状态栏白色图标压在亮剧照上也能看清 -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/shape_top_scrim"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 文字上滑到剧照清晰区时随滚动整体压暗，保证白字始终可读 -->
    <View
        android:id="@+id/detailDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.06"
        android:background="@color/black"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/video">

        <com.fongmi.android.tv.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/detailContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingTop="36dp"
                    android:paddingBottom="100dp">

                    <!-- 剧名：源数据只有文字，没有艺术字 logo，用大号居中标题替代 -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="唐朝诡事录" />

                    <!-- 元信息一行：更新备注 · 年份 · 地区 · 类型（由 Java 动态拼接） -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/other"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textColor="@color/white_70"
                        android:textSize="12.5sp"
                        tools:text="更新至30 · 2026 · 中国大陆 · 古装" />

                    <!-- 播放 / 继续播放：宽胶囊（实心主题色，由 Java 上色）。高度随字号自适应，避免大字体下集数换行被裁 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deferredPlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="24dp"
                        android:backgroundTint="@color/primary"
                        android:gravity="center"
                        android:maxLines="2"
                        android:minHeight="50dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/play_deferred"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:cornerRadius="25dp"
                        app:icon="@drawable/ic_play_arrow"
                        app:iconGravity="textStart"
                        app:iconTint="@color/black"
                        tools:visibility="visible" />

                    <!-- 圆形操作图标：搜索 / 收藏 / 投屏 / 设置 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/detailActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/quickBtn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shape_icon_circle"
                            android:elevation="2dp"
                            android:padding="11dp"
                            android:src="@drawable/ic_action_search"
                            app:tint="@color/white_70" />

                        <!-- 收藏是自己的状态按钮：未收藏细描边星，已收藏实心暖金圆底 -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/keepBtn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shape_icon_circle"
                            android:elevation="2dp"
                            android:padding="11dp"
                            android:src="@drawable/ic_control_keep_off"
                            app:tint="@color/white_70" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/castBtn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shape_icon_circle"
                            android:elevation="2dp"
                            android:padding="11dp"
                            android:src="@drawable/ic_control_cast"
                            app:tint="@color/white_70" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/settingBtn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shape_icon_circle"
                            android:elevation="2dp"
                            android:padding="11dp"
                            android:src="@drawable/ic_action_setting"
                            app:tint="@color/white_70" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- 简介 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/content_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginEnd="20dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iconContent"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_control_info" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/headerContent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_content"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="4dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="6dp"
                            android:maxLines="2"
                            android:textColor="@color/white_70"
                            android:textSize="14sp"
                            tools:text="該劇改編自作家魏風華同名原著，講述了在繁華的大唐盛世之下發生的一系列奇聞異事。" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- 线路 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iconFlag"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_site_change" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/headerFlag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_flag"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/flag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/quality_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="20dp"
                        android:text="@string/detail_quality"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:visibility="visible" />

                    <!-- 选集 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iconEpisode"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_action_more" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/headerEpisode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_episode"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/reverse"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/shape_pill"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/play_reverse"
                            android:textColor="@color/white_70"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_action_more"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/episode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="4" />

                    <!-- 演职人员：源数据只有文字，没有头像 -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/director"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:singleLine="true"
                        android:textColor="@color/white_70"
                        android:textSize="13sp"
                        tools:text="导演：郭世民" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/actor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="20dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/white_70"
                        android:textSize="13sp"
                        tools:text="演员：杨旭文 杨志刚 郜思雯" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/quickHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iconQuick"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_action_sync" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/headerQuick"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_source"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/adapter_quick"
                        tools:visibility="visible" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.fongmi.android.tv.ui.custom.ProgressLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 详情态悬浮控件：剧照铺满整屏时也能直接返回/收藏，不用先找按钮 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/detailBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_below="@id/statusBar"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/shape_circle_scrim"
        android:padding="9dp"
        android:src="@drawable/ic_control_back"
        android:visibility="gone"
        app:tint="@color/white"
        tools:visibility="visible" />

</RelativeLayout>
