<?xml version="1.0" encoding="utf-8"?>
<!-- 内置壁纸上的一层压暗：顶部/底部更深（保住状态栏与片名可读），中间大面积留亮 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:centerColor="#1A000000"
        android:centerY="0.34"
        android:endColor="#66000000"
        android:startColor="#8C000000"
        android:type="linear" />

</shape>
